# Contact form email delivery (uses Resend: https://resend.com)
# Without these, the form works in development (messages are logged to the
# terminal) and shows a "not set up yet" message in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Sanity project used by the embedded Studio and blog.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
